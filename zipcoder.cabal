cabal-version:      2.4
name:               zipcoder
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- A URL where users can report bugs.
-- bug-reports:

-- The license under which the package is released.
-- license:
author:             Josep Bigorra
maintainer:         jjbigorra@gmail.com 

-- A copyright notice.
-- copyright:
-- category:
extra-source-files: CHANGELOG.md

library
  exposed-modules:
    ZipCoder.Lib
    ZipCoder.Model
    ZipCoder.OptionsParser

  -- Modules included in this executable, other than Main.
  -- other-modules:

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  build-depends:
    , base                  >=4 && < 5
    , containers            ^>=0.6.4
    , optparse-applicative  ^>=0.16.1.0
    , raw-strings-qq        ^>=1.1
    , regex-pcre            ^>=0.95.0
    , split                 ^>=0.2.3

  hs-source-dirs:   src
  default-language: Haskell2010

executable zipcoder
  main-is:          Main.hs

  -- Modules included in this executable, other than Main.
  -- other-modules:

  -- LANGUAGE extensions used by modules in this package.
  -- other-extensions:
  build-depends:
    , base      >=4 && < 5
    , zipcoder

  hs-source-dirs:   app
  default-language: Haskell2010

test-suite spec
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs:
      testsuite/tests
  ghc-options: -Wall
  build-depends:       
    , base >=4 && < 5
    , QuickCheck ^>=2.14.2 
    , hspec ==2.*
    , containers            ^>=0.6.4
    , zipcoder
  default-language: Haskell2010
  build-tool-depends: hspec-discover:hspec-discover == 2.*
  other-modules:
    ZipCoder.LibSpec
